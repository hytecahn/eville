[Unit]
Description=EzVille telemetry receiver behind HTTPS reverse proxy
After=network.target
[Service]
User=ezville-receiver
EnvironmentFile=/etc/ezville/receiver.env
ExecStart=/usr/bin/python3 /opt/eville/monitoring/receiver.py
Restart=on-failure
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ezville
[Install]
WantedBy=multi-user.target
